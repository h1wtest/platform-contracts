{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.local/contracts/quarantine-replay-v2.json",
  "title": "Privileged corrected event replay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reason"
  ],
  "properties": {
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "corrected_event": {
      "oneOf": [
        {
          "$ref": "events-v1.json"
        },
        {
          "$ref": "events-v2.json"
        }
      ]
    }
  }
}
