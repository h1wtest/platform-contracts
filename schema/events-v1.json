{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sso.local/contracts/events-v1.json",
  "title": "Platform event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_type", "aggregate_id", "occurred_at"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "format": "uuid"},
    "event_type": {"enum": ["identity.user_registered", "identity.user_logged_in", "identity.email_verified", "identity.password_changed", "identity.mfa_changed", "identity.session_revoked", "identity.user_banned", "identity.user_unbanned", "notification.email_verification", "notification.password_reset"]},
    "aggregate_id": {"type": "string", "format": "uuid"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "traceparent": {"type": "string", "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$", "not": {"pattern": "^00-(00000000000000000000000000000000-|[0-9a-f]{32}-0000000000000000-)"}},
    "payload": {"type": "object"},
    "encrypted_payload": {"type": "string", "contentEncoding": "base64", "minLength": 40, "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
  },
  "oneOf": [
    {"required": ["payload"], "not": {"required": ["encrypted_payload"]}, "properties": {"event_type": {"enum": ["identity.user_registered", "identity.user_logged_in", "identity.email_verified", "identity.password_changed", "identity.mfa_changed", "identity.session_revoked", "identity.user_banned", "identity.user_unbanned"]}}},
    {"required": ["encrypted_payload"], "not": {"required": ["payload"]}, "properties": {"event_type": {"enum": ["notification.email_verification", "notification.password_reset"]}}}
  ],
  "allOf": [
    {"if": {"properties": {"event_type": {"const": "identity.user_registered"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/UserRegistered"}}}},
    {"if": {"properties": {"event_type": {"const": "identity.user_logged_in"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/UserLoggedIn"}}}},
    {"if": {"properties": {"event_type": {"const": "identity.email_verified"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/EmailVerified"}}}},
    {"if": {"properties": {"event_type": {"const": "identity.password_changed"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/PasswordChanged"}}}},
    {"if": {"properties": {"event_type": {"const": "identity.mfa_changed"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/MFAChanged"}}}},
    {"if": {"properties": {"event_type": {"const": "identity.session_revoked"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/SessionRevoked"}}}},
    {"if": {"properties": {"event_type": {"const": "identity.user_banned"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/UserBanned"}}}},
    {"if": {"properties": {"event_type": {"const": "identity.user_unbanned"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/UserUnbanned"}}}}
  ],
  "$defs": {
    "UserRegistered": {"x-event-type": "identity.user_registered", "type": "object", "additionalProperties": false, "required": ["user_id", "email"], "properties": {"user_id": {"type": "string", "format": "uuid"}, "email": {"type": "string", "minLength": 1}}},
    "UserLoggedIn": {"x-event-type": "identity.user_logged_in", "type": "object", "additionalProperties": false, "required": ["user_id", "session_id", "ip_address", "user_agent", "device_name", "logged_in_at"], "properties": {"user_id": {"type": "string", "format": "uuid"}, "session_id": {"type": "string", "format": "uuid"}, "ip_address": {"type": "string"}, "user_agent": {"type": "string"}, "device_name": {"type": "string"}, "logged_in_at": {"type": "string", "format": "date-time"}}},
    "EmailVerified": {"x-event-type": "identity.email_verified", "type": "object", "additionalProperties": false, "required": ["user_id"], "properties": {"user_id": {"type": "string", "format": "uuid"}}},
    "PasswordChanged": {"x-event-type": "identity.password_changed", "type": "object", "additionalProperties": false, "required": ["user_id"], "properties": {"user_id": {"type": "string", "format": "uuid"}}},
    "MFAChanged": {"x-event-type": "identity.mfa_changed", "type": "object", "additionalProperties": false, "required": ["user_id", "enabled"], "properties": {"user_id": {"type": "string", "format": "uuid"}, "enabled": {"type": "boolean"}}},
    "SessionRevoked": {"x-event-type": "identity.session_revoked", "type": "object", "additionalProperties": false, "required": ["user_id", "session_id", "reason"], "properties": {"user_id": {"type": "string", "format": "uuid"}, "session_id": {"type": "string", "format": "uuid"}, "reason": {"type": "string", "minLength": 1}}},
    "UserBanned": {"x-event-type": "identity.user_banned", "type": "object", "additionalProperties": false, "required": ["user_id", "reason"], "properties": {"user_id": {"type": "string", "format": "uuid"}, "reason": {"type": "string", "minLength": 1}}},
    "UserUnbanned": {"x-event-type": "identity.user_unbanned", "type": "object", "additionalProperties": false, "required": ["user_id"], "properties": {"user_id": {"type": "string", "format": "uuid"}}},
    "EmailVerification": {"x-event-type": "notification.email_verification", "type": "object", "additionalProperties": false, "required": ["user_id", "email", "code", "expires_at"], "properties": {"user_id": {"type": "string", "format": "uuid"}, "email": {"type": "string", "minLength": 1}, "code": {"type": "string", "minLength": 1}, "expires_at": {"type": "string", "format": "date-time"}}},
    "PasswordReset": {"x-event-type": "notification.password_reset", "type": "object", "additionalProperties": false, "required": ["user_id", "email", "token", "expires_at"], "properties": {"user_id": {"type": "string", "format": "uuid"}, "email": {"type": "string", "minLength": 1}, "token": {"type": "string", "minLength": 1}, "expires_at": {"type": "string", "format": "date-time"}}}
  }
}
